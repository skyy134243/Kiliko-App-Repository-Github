# Kiliko.App Environment Variables

# Database connection (Prisma / PostgreSQL or SQLite)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Tokens
JWT_SECRET="kiliko-app-secret-key-change-in-production-2026"

# Bot Automation Webhook / Notification Channel (for BK notification)
BK_BOT_WEBHOOK_URL="https://api.telegram.org/bot<TOKEN>/sendMessage"

# AI OCR Provider for Soal Pilihan Ganda (Google Gemini Vision / Tesseract)
GEMINI_API_KEY="your-gemini-api-key-here"

# App Public URL (used for QR code verification target)
VITE_APP_URL="http://localhost:3000"
